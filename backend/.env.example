# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# String de conexão com o banco de dados MariaDB/MySQL na Hostinger
# Formato: mysql://usuario_hostinger:senha_banco@localhost:3306/nome_banco_hostinger
DATABASE_URL="mysql://u123456789_thebridge:SuaSenhaForteAqui@localhost:3306/u123456789_thebridge"

NODE_ENV=production
PORT=3000

# IMPORTANTE: JWT_SECRET precisa ter no mínimo 32 caracteres (exigência da validação Zod no env.validation.ts)
JWT_SECRET=thebridge_super_secret_jwt_key_production_2026_at_least_32_chars
JWT_EXPIRES_IN_SECONDS=86400

# Origens autorizadas pelo CORS (separadas por vírgula)
CORS_ORIGIN=https://thebridge.app.br,https://www.thebridge.app.br,http://localhost:5173   